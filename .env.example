# Copy to .env for local runs. On Netlify these are site environment variables.

# Required: without it the questionnaire answers "not set up yet".
ANTHROPIC_API_KEY=

# Where every submission and "Talk to us" message is copied. Comma-separated.
OWNER_EMAIL=

# Azure Communication Services email (the same kind of resource RADS10 uses).
# Without all three nothing is emailed; results still show on the page.
MAIL_ENDPOINT=
MAIL_KEY=
MAIL_FROM=

# Saves submissions and messages to the database through the shared API.
# Must match YPTB_KEY on the ceustamps-api Web App. Without it they are kept in
# Netlify Blobs (in memory when running locally).
YPTB_API_KEY=
# YPTB_API_URL=https://ceustamps-api.azurewebsites.net/api/yourparttimebiz

# Optional
# IDEAS_MODEL=claude-opus-5-5
# IDEAS_EFFORT=low
# LIMIT_PER_EMAIL=3
# LIMIT_PER_IP=10
# LIMIT_PER_DAY=300

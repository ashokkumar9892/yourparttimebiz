# Copy to .env for local runs. On Netlify these are site environment variables.

# Required: without it the questionnaire answers "not set up yet".
ANTHROPIC_API_KEY=

# Where every submission and "Talk to us" message is copied. Comma-separated.
OWNER_EMAIL=

# Azure Communication Services email (the same kind of resource RADS10 uses).
# Without all three nothing is emailed; results still show on the page.
MAIL_ENDPOINT=
MAIL_KEY=
MAIL_FROM=

# Optional
# IDEAS_MODEL=claude-opus-5-5
# IDEAS_EFFORT=low
# LIMIT_PER_EMAIL=3
# LIMIT_PER_IP=10
# LIMIT_PER_DAY=300
